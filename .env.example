# Copy this file to .env and fill in real values. Never commit .env.
# The app checks these at startup (src/config/env.js) and refuses to start
# if any value is missing or invalid.

# development, test or production (default: development)
NODE_ENV=development

# Port the API listens on (default: 5000)
PORT=5000

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/biztrack?schema=public"

# Secret used to sign login tokens (required, at least 32 characters).
# The app refuses to start with this placeholder. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Websites allowed to call the API, comma-separated full URLs.
# Optional in development, required in production.
CORS_ORIGINS=http://localhost:3000
